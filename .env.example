# --- server ---
# Local runs use 8080 to avoid needing root; Docker uses 80 (default).
PORT=8080
LOG_LEVEL=info          # debug | info | warn | error   (debug logs full raw payloads)
LOG_FORMAT=text         # text | json

# --- watched logic ---
WATCHED_THRESHOLD=0.90  # fraction of runtime; a Playback Stop counts as "watched"
                        # when PlayedToCompletion is true OR position/runtime >= this
DEDUP_TTL=6h            # suppress duplicate notifications for the same user+item

# --- SCN (Simple Cloud Notifier) push ---
# Enabled when SCN_USER_ID and SCN_KEY are both set.
SCN_USER_ID=
SCN_KEY=
SCN_CHANNEL=jellyfin
SCN_PRIORITY=1          # 0 | 1 | 2
SCN_ACCOUNTS=ALL        # ALL, or a comma list of Jellyfin usernames
# SCN_BASE_URL=https://simplecloudnotifier.blackforestbytes.com/

# --- Joplin watch log ---
# Enabled when JOPLIN_TOKEN, JOPLIN_NOTE_ID and JOPLIN_ACCOUNTS are all set.
JOPLIN_BASE_URL=http://10.8.0.4:4466
JOPLIN_TOKEN=
JOPLIN_NOTE_ID=
JOPLIN_ANCHOR=          # a text marker in the note; new lines are inserted before it
JOPLIN_POSITION=before  # before | after
JOPLIN_ACCOUNTS=        # ALL, or a comma list of Jellyfin usernames to log
